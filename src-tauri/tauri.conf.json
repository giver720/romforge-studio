{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROMForge Studio",
  "mainBinaryName": "romforge-studio",
  "version": "2.2.0",
  "identifier": "com.chdstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ROMForge Studio",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNUI2NzkzMUMyMzQ4QzgKUldUSVNDTWNrMmRiSTFDL0xwNTRBQzRiMERpcitOV2w3eFo5SkdaTGs2RTBZdWptQ21zK0JISU4K",
      "endpoints": [
        "https://github.com/giver720/romforge-studio/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["binaries/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
