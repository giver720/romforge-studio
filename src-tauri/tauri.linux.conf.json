{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "category": "Utility",
    "targets": ["deb"],
    "createUpdaterArtifacts": false,
    "resources": ["binaries/LEEME.txt"],
    "longDescription": "ROMForge Studio convierte imagenes de disco de PS1, PS2, PS3, PS5, PSP, Dreamcast, Saturn, Xbox 360, Wii, GameCube, 3DS y Switch. En PS5 crea, comprime, verifica y extrae imagenes exFAT, FFPKG y FFPFSC compatibles con ShadowMountPlus.",
    "linux": {
      "deb": {
        "depends": ["mame-tools"],
        "provides": ["chd-studio"],
        "conflicts": ["chd-studio"],
        "replaces": ["chd-studio"],
        "recommends": [
          "python3",
          "python3-venv",
          "git",
          "build-essential",
          "pkg-config",
          "libuv1-dev",
          "liblz4-dev",
          "zlib1g-dev"
        ],
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
