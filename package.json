{
  "name": "romforge-studio",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "description": "Suite para convertir, comprimir y preparar juegos para consolas y emuladores",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "bridge:windows": "powershell -ExecutionPolicy Bypass -File tools/build-prospero-bridge.ps1 && powershell -ExecutionPolicy Bypass -File tools/build-ampr-bridge.ps1",
    "bridge:linux": "bash tools/build-prospero-bridge.sh && bash tools/build-ampr-bridge.sh",
    "dist": "npm run bridge:windows && tauri build --no-sign",
    "dist:linux": "npm run bridge:linux && tauri build --bundles deb",
    "chdman": "powershell -ExecutionPolicy Bypass -File tools/obtener-chdman.ps1",
    "check:tools": "python tools/validar-herramientas.py",
    "store:catalog": "python tools/homebrew_catalog.py",
    "tools:fetch": "powershell -ExecutionPolicy Bypass -File tools/obtener-herramientas.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File tools/publicar.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
